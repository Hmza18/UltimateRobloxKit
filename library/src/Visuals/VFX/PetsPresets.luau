-- Pet VFX presets (pure data): spawn and despawn, equip, reactions, upgrade, evolve, fusion,
-- teleport, summon, collection and the looping rarity aura.

local EffectLogic = require("./EffectLogic")
local Recipe = require("./RecipeLogic")
local Registry = require("../Core/Registry")

local R = Recipe
local P = Recipe.particles

local function rarityAura(t: Recipe.Tier): EffectLogic.Definition
	local p = t.palette
	local rank = t.rank
	return {
		looping = true,
		layers = R.join(
			P({
				name = "motes",
				colors = { p.core, p.main },
				sizes = { 0, 0.22 * t.size, 0 },
				lifetime = { 1.1, 1.7 },
				speed = { 0.8, 2 },
				spread = { 25, 25 },
				rate = 5 * t.count,
				shape = "Cylinder",
				shapeSize = { 3, 0.4, 3 },
				lightEmission = 1,
			}),
			rank >= 2
				and P({
					name = "breath",
					texture = "glow",
					colors = { p.light, p.main },
					sizes = { 1.5, 2.6 * t.size, 1.5 },
					transparency = { 1, 0.8, 1 },
					lifetime = { 1.6, 2.2 },
					speed = { 0, 0 },
					rate = 1,
					lightEmission = 1,
					lockedToPart = true,
				}),
			rank >= 3
				and R.light(p.main, {
					range = 7 + rank,
					brightness = 0.8 + 0.2 * rank,
					fadeIn = 0.4,
					pulse = { 2.6 - 0.2 * rank, 0.3 },
				}),
			rank >= 3
				and R.sparkles(p.accent, {
					name = "orbit",
					burst = false,
					rate = 2 * rank,
					speed = { 0.2, 1 },
					shape = "Cylinder",
					shapeStyle = "Surface",
					shapeSize = { 4.5, 2, 4.5 },
				}),
			rank >= 4
				and R.streaks(p.light, {
					name = "wisps",
					burst = false,
					rate = 2 * rank,
					speed = { 5, 8 },
					spread = { 6, 6 },
					lifetime = { 0.5, 0.8 },
					drag = 1,
					shape = "Cylinder",
					shapeSize = { 3.5, 0.3, 3.5 },
					optional = true,
				}),
			rank >= 5
				and R.beam(p.main, {
					width = { 2.2, 0.4 },
					length = 6 + rank,
					transparency = { 0.6, 0.85, 1 },
					fadeIn = 0.5,
				}),
			rank >= 5 and R.highlight(p.main, { fillTransparency = 0.85, fadeIn = 0.4 }),
			rank >= 6
				and P({
					name = "embers",
					colors = { p.accent, EffectLogic.darken(p.accent, 0.3) },
					sizes = { 0.2, 0.12, 0 },
					lifetime = { 1.4, 2.2 },
					speed = { 1.5, 3.5 },
					spread = { 50, 50 },
					rate = 7,
					gravity = 2,
					drag = 1,
					lightEmission = 1,
				}),
			rank >= 7
				and P({
					name = "prism",
					colors = { "#2CF5E0", "#FF5CF4", "#FFF27A" },
					sizes = { 0, 0.4, 0 },
					lifetime = { 1.2, 1.8 },
					speed = { 1, 3 },
					rate = 6,
					shape = "Sphere",
					shapeSize = { 5, 5, 5 },
					rotSpeed = { -120, 120 },
					lightEmission = 1,
					optional = true,
				})
		),
	}
end

