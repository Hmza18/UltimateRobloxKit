local EffectLogic = require("./EffectLogic")
local Recipe = require("./RecipeLogic")
local Registry = require("../Core/Registry")

local R = Recipe
local P = Recipe.particles

-- Streaks that rise in a column from a ring on the ground.
local function column(color: string, overrides: { [string]: any }?): EffectLogic.Layer
	return R.merge(
		R.streaks(color, {
			name = "column",
			burst = false,
			rate = 36,
			emitFor = 0.7,
			speed = { 14, 22 },
			spread = { 5, 5 },
			lifetime = { 0.3, 0.5 },
			drag = 1,
			shape = "Cylinder",
			shapeSize = { 4, 0.3, 4 },
		}) :: any,
		overrides
	)
end

